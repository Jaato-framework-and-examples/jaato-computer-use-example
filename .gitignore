# --- Android / Gradle ---
.gradle/
build/
*/build/
**/build/
local.properties
*.iml
.idea/
.externalNativeBuild/
.cxx/
.kotlin/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Credentials: NEVER commit ---
# The controller reads JAATO_DOUBLEWORD_API_KEY from controller/.env
# (forwarded to the daemon via env_file). Keep the live key out of git;
# commit controller/.env.example as the template instead.
.env
**/.env
!**/.env.example

# --- Signing secrets: NEVER commit ---
*.jks
*.keystore
keystore.properties

# --- Runtime / session state: NEVER publish ---
# Framework workspace state, agent transcripts, and anything captured from a real device.
.jaato/
.claude/
captures/
*.webp
*.jpg
*.jpeg
!docs/**/*.png

# --- OS ---
.DS_Store
Thumbs.db
